# ==============================================================================
# GoTradeX Environment Configuration Template
# ==============================================================================
# WARNING: Do not commit actual credentials, passwords, or secrets to Git.
# Copy this file to '.env' and configure appropriate secure secrets before running.

# Database Configuration (Development defaults only)
# ALWAYS change DB_PASSWORD to a strong random value in production.
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_RANDOM_PASSWORD
DB_NAME=gotradex

# Database Connection (Production-ready template)
# In production, SSL must be enabled (sslmode=require or verify-full).
DATABASE_URL=postgres://postgres:YOUR_STRONG_RANDOM_PASSWORD@postgres:5432/gotradex?sslmode=require

# Message Broker Configuration
# For production, consider enabling SSL/SASL authentication.
KAFKA_BROKERS=kafka:9092

# Docker Image Configurations
IMAGE_TAG=latest
GITHUB_REPOSITORY_OWNER=your-username
